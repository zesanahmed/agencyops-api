# Server
NODE_ENV=development
PORT=5000


DATABASE_URL=postgresql://user:password@localhost:5432/agencyops


REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

REFRESH_TOKEN_COOKIE_NAME=agencyops_refresh_token
REFRESH_TOKEN_COOKIE_SAME_SITE=strict

# CORS — comma-separated list of allowed frontend origins.
# Unset in production = no cross-origin requests allowed at all
# (fails closed). Dev default if unset: localhost:3000, localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Reverse proxy hops in front of the API (Render, Vercel, nginx...). Leave unset locally.
# Set to 1 when deployed behind a single proxy, otherwise every user appears to come from the
# proxy's IP and shares one rate-limit bucket. Do NOT set it when the API is exposed directly:
# clients could then spoof their IP via X-Forwarded-For.
# Accepts "false", "true", a hop count (1) or an Express IP/subnet list.
# TRUST_PROXY=1

# Cloudinary (file uploads) — optional; the rest of the app runs fine
# without these, only the file-upload endpoints return an error.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (billing + client invoice payments) — optional; billing endpoints
# return 503 until these are set. Use TEST-mode keys (sk_test_...) in dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id (price_...) of the recurring PRO plan created in your Stripe dashboard.
STRIPE_PRO_PRICE_ID=

# Email (Resend) — optional; without a key the worker only logs recipient +
# subject in development and fails jobs in production. EMAIL_FROM must be a
# sender on a domain verified in Resend (the default only reaches your own
# Resend account email).
RESEND_API_KEY=
EMAIL_FROM=AgencyOps <onboarding@resend.dev>

# OAuth sign-in — optional; a provider without both values returns 503. Register
# this callback URL with the provider:  <API_PUBLIC_URL>/api/v1/auth/oauth/<google|github>/callback
API_PUBLIC_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base URL of the web app; Stripe Checkout returns the user here.
FRONTEND_URL=http://localhost:3000
