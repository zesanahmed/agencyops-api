# Server
NODE_ENV=development
PORT=5000

# Database — required in EVERY environment (no dev fallback exists
# for this one; unlike the JWT secrets below, there's no safe
# placeholder for a connection string, the app just can't run
# without a real one)
DATABASE_URL=postgresql://user:password@localhost:5432/agencyops

# Redis (used by BullMQ and other Redis-backed infrastructure)
# Local dev default if unset: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# JWT — access & refresh tokens use SEPARATE secrets on purpose, so
# leaking one type of token's secret doesn't compromise the other.
# Required in production (the app refuses to start without them);
# in development, an insecure placeholder is used with a warning if
# left unset — do not rely on that outside local dev.
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Refresh-token cookie (HttpOnly; Secure is forced on automatically
# whenever NODE_ENV=production)
REFRESH_TOKEN_COOKIE_NAME=agencyops_refresh_token
REFRESH_TOKEN_COOKIE_SAME_SITE=strict

